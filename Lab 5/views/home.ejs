<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planets website</title>
    <%- include('partials/includes.ejs')%>
        <link rel="stylesheet" href="style.css">
</head>

<body>
    <header>
        <h1>Welcome to the planets!</h1>
        <%- include('partials/navbar.ejs')%>
    </header>
    <main id="home_main">
        <% if (images.length===0) { %>
            <p>could not request random images</p>
            <% } %>
                <% for (const image of images) { %>
                    <img class="home_image" src="<%= image %>" alt="Random solar system image from Pixabay">
                    <%}%>
    </main>
    <footer>
        <%- include('partials/fun.ejs')%>
    </footer>
</body>

</html>